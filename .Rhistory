), output = "table_comparison_interest.html", stars = TRUE, coef_map = c("opc" = "Civic Opportunity Score", "race_factorAsian" = "Asian", "race_factorLatino" = "Latino", "race_factorBlack" = "Black", "agenum" = "Age", "income_ordinal" = "Income", "pid7" = "Partisan Identification", "opc:agenum" = "Age X Political Interest Interaction Effect"), coef_omit = "Intercept")
