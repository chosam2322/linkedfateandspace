), output = "table_comparison_turnout.png", stars = TRUE, coef_map = c("opc" = "Civic Opportunity Score", "race_factorAsian" = "Asian", "race_factorLatino" = "Latino", "race_factorBlack" = "Black", "agenum" = "Age", "income_ordinal" = "Income", "opc:agenum" = "Age X Political Interest Interaction Effect"), coef_omit = "Intercept")
