),
alpha = 0.15,
color = NA
) +
geom_line(
linewidth = 1
) +
geom_vline(
xintercept = 40,
linetype = "dotted"
) +
labs(
x = "Age",
y = "Conditional association of civic density (OPC)",
linetype = NULL
) +
scale_x_continuous(
breaks = seq(20, 60, by = 10),
limits = c(18, 65)
) +
theme_minimal() +
theme(
legend.position = "bottom"
)
# Mean age used to center age
age_mean <- mean(cmps_merged$agenum, na.rm = TRUE)
# Ages at which to estimate the conditional OPC association
age_grid <- seq(18, 65, length.out = 100)
# Center age
age_c_grid <- age_grid - age_mean
# Economic pessimism model coefficients
b_pess <- coef(minimal_economic_interaction_controlled)
V_pess <- vcov(minimal_economic_interaction_controlled)
# Conditional OPC association at each age
pess_est <- b_pess["opc"] +
b_pess["opc:age_c"] * age_c_grid
# Standard error of conditional OPC association
pess_se <- sqrt(
V_pess["opc", "opc"] +
age_c_grid^2 * V_pess["opc:age_c", "opc:age_c"] +
2 * age_c_grid * V_pess["opc", "opc:age_c"]
)
pessimism_slopes <- data.frame(
age = age_grid,
estimate = as.numeric(pess_est),
conf.low = as.numeric(pess_est - 1.96 * pess_se),
conf.high = as.numeric(pess_est + 1.96 * pess_se),
Outcome = "Economic pessimism"
)
# Political interest model coefficients
b_interest <- coef(minimal_political_interaction_controlled)
V_interest <- vcov(minimal_political_interaction_controlled)
# Conditional OPC association at each age
interest_est <- b_interest["opc"] +
b_interest["opc:age_c"] * age_c_grid
# Standard error of conditional OPC association
interest_se <- sqrt(
V_interest["opc", "opc"] +
age_c_grid^2 * V_interest["opc:age_c", "opc:age_c"] +
2 * age_c_grid * V_interest["opc", "opc:age_c"]
)
interest_slopes <- data.frame(
age = age_grid,
estimate = as.numeric(interest_est),
conf.low = as.numeric(interest_est - 1.96 * interest_se),
conf.high = as.numeric(interest_est + 1.96 * interest_se),
Outcome = "Political interest"
)
plot_data <- bind_rows(
pessimism_slopes,
interest_slopes
)
# Check that everything looks right
head(plot_data)
names(plot_data)
ggplot(
plot_data,
aes(
x = age,
y = estimate,
linetype = Outcome
)
) +
geom_hline(
yintercept = 0,
linetype = "dashed"
) +
geom_ribbon(
aes(
ymin = conf.low,
ymax = conf.high
),
alpha = 0.15,
color = NA
) +
geom_line(
linewidth = 1
) +
geom_vline(
xintercept = 40,
