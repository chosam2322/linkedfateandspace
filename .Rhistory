library(tidyverse)
library(lubridate)
library(readr)
library(janitor)
library(here)
library(haven)
library(modelsummary)
library(ggeffects)
library(margins)
library(scales)
library(nnet)
library(broom)
library(tigris)
library(marginaleffects)
# Creation of Income Gradient Plot to Show Differential Impact
# of Civic Density Across Income Groups
model_incomefactor <- lm(
voted_2024 ~ opc * income_factor + race_factor + gender_factor +
age_c + pid7_c,
data = cmps_merged
)
model.frame(model_incomefactor)$income_factor |> levels()
income_levels_used <- levels(model.frame(model_incomefactor)$income_factor)
me_incomefactor <- slopes(
model_incomefactor,
variables = "opc",
newdata = datagrid(income_factor = income_levels_used),
type = "response"
)
income_gradient_plot <- ggplot(
me_incomefactor,
aes(x = income_factor, y = estimate)
) +
geom_point(
size = 3,
color = "black"
) +
geom_errorbar(
aes(ymin = conf.low, ymax = conf.high),
width = 0.15,
color = "black"
) +
geom_hline(
yintercept = 0,
linetype = 2,
color = "gray50"
) +
labs(
x = "Household income",
y = "Marginal effect of civic density on predicted turnout",
title = "Effect of Civic Density by Income"
) +
theme_minimal(base_size = 12)
income_gradient_plot
ggsave(
filename = "incomegradientplot.png",
plot = income_gradient_plot,
width = 8,
height = 6,
dpi = 300
)
coef_df_interaction <- imap_dfr(
list(
"Bivariate Model" = model_2024_interaction,
"Model Including Controls" = model_2024_interaction_minimal
),
~ tidy(.x, conf.int = TRUE) |> mutate(model = .y)
) |>
filter(term == "opc")
model_comparison_interaction <- ggplot(coef_df_interaction, aes(x = estimate, y = model, shape = model)) +
geom_point(size = 3, color = "black") +
geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0.2, color = "black") +
geom_vline(xintercept = 0, linetype = 2, color = "gray50") +
scale_shape_manual(values = c(16, 17)) +
theme_minimal() +
labs(
title = "Civic Opportunity Density, Age, and Voter Turnout in the 2024 Election",
x = "Coefficient estimate for Civic Density",
y = NULL,
shape = "Model"
) +
theme(
legend.position = "none",
panel.grid.minor = element_blank()
)
model_comparison_interaction
